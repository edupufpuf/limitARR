# Seerr / Tautulli — opcional: solo sirve para rellenar la primera vez que
# arranca (se guarda en la DB). Después se edita desde el panel, pestaña
# Configuración, sin tocar variables de entorno ni reiniciar el contenedor.
SEERR_URL=http://seerr:5055
SEERR_API_KEY=

TAUTULLI_URL=http://tautulli:8181
TAUTULLI_API_KEY=

# Admin panel — ambas opcionales. Sin contraseña definida, el panel pide
# crearla en el primer acceso (se guarda hasheada en la DB, cambiable después
# desde Configuración). ADMIN_PASSWORD solo sirve para no perder el acceso al
# actualizar un despliegue que ya la tenía en env. SESSION_SECRET, si no se
# pone, se genera solo y se persiste en la DB.
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional tuning
PORT=5150
POLL_INTERVAL_MS=60000
